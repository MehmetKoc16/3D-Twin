* text=auto eol=lf

# Git LFS: binary 3D assets
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf-bin filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Git LFS: textures shipped with the web app
apps/web/public/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
apps/web/public/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
apps/web/public/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
apps/web/public/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text

# Other images: plain binary
*.png binary
*.jpg binary
